<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_ho_tro_va_thong_tin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nen_app"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imgQuayLai"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_left_96"/>

            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/avata_app"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedImage" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ho_tro_amp_thong_tin_ung_dung"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/thong_tin"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/Gray"
            android:layout_marginTop="15dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btnHoTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:background="@drawable/cus_button_light_gray"
            android:backgroundTint="@color/light_gray"
            android:text="@string/lien_he_ho_tro" />

        <Button
            android:id="@+id/btnBaoMat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/black"
            android:background="@drawable/cus_button_light_gray"
            android:backgroundTint="@color/light_gray"
            android:textSize="14sp"
            android:text="@string/chinh_sach_bao_mat"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>